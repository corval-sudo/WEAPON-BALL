# .env.example — copy to .env and fill in your values

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed CORS origins (browser URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Anthropic (AI features) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── Telegram (optional match notifications) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Scheduling ────────────────────────────────────────────────────────────────
# Set to "1" to disable auto-scheduling (trigger matches manually via POST /api/admin/run-match)
MANUAL_MATCH=0

# ── Admin / Recording (frontend) ─────────────────────────────────────────────
# Set to "true" to show the admin recording panel in the web viewer.
# Must be prefixed VITE_ to be exposed to the browser by Vite.
VITE_ADMIN_MODE=false

# URL of the API server, as seen by the browser
VITE_API_URL=http://localhost:3001

# ── Orbacle Content Pipeline ──────────────────────────────────────────────────
# Set to "true" to enable autonomous match selection and social posting.
# Currently a stub — no posts are made regardless of this value.
ORBACLE_POSTING=false

# ── X / Twitter (tournament final auto-posting) ───────────────────────────────
# Get these from https://developer.twitter.com → Your App → Keys and Tokens
# The app must have Read and Write permissions (OAuth 1.0a).
# These env vars take priority over the DB config (set via npm run admin set).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Set to "true" to enable. The first tournament of each UTC day posts to X.
X_ENABLED=false
